			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>Истории, которыми поделились</string>
			<key>many</key>
			<string>Истории, которыми поделились</string>
			<key>one</key>
			<string>Публикация, которой поделились</string>
			<key>other</key>
			<string>Истории, которыми поделились</string>
		</dict>
	</dict>
