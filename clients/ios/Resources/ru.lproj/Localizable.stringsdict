			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>Отметить эти %@ записей как прочитанные</string>
			<key>many</key>
			<string>Отметить эти %@ историй как прочитанные</string>
			<key>one</key>
			<string>Отметить %@ историю как прочитанную</string>
			<key>other</key>
			<string>Отметить эти %@ статьи как прочитанные</string>
		</dict>
	</dict>
	<key>Mute %@ Sites</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@site_count@</string>
