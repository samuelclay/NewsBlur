			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>%@ подписчика</string>
			<key>many</key>
			<string>%@ подписчиков</string>
			<key>one</key>
			<string>%@ подписчик</string>
			<key>other</key>
			<string>%@ подписчиков</string>
