			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>Поисковых запросов: %@</string>
			<key>many</key>
			<string>%@ поисковых запросов</string>
			<key>one</key>
			<string>%@ поиск</string>
			<key>other</key>
			<string>%@ поисковых запросов</string>
