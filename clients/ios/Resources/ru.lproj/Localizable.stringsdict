		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>Хранение за последние %@ дней</string>
			<key>many</key>
			<string>Хранение за последние %@ дней</string>
			<key>one</key>
			<string>Хранить за прошедший %@ день</string>
			<key>other</key>
			<string>Хранение данных за последние %@ дней</string>
		</dict>
	</dict>
	<key>Storing past %@ hours</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@hours@</string>
		<key>hours</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>Хранить за последние %@ часов</string>
			<key>many</key>
			<string>Хранить за последние %@ ч.</string>
			<key>one</key>
			<string>Хранить за последний %@ час</string>
			<key>other</key>
			<string>Хранить за последние %@ ч.</string>
