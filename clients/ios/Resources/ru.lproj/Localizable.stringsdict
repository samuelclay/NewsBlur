			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>Вы подписаны на %@ сайта</string>
			<key>many</key>
			<string>Вы подписаны на %@ сайтов</string>
			<key>one</key>
			<string>Вы подписаны на %@ сайт</string>
			<key>other</key>
			<string>Вы подписаны на %@ сайтов</string>
