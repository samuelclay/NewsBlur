		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>Старше %@ дней</string>
			<key>many</key>
			<string>Старше %@ дней</string>
			<key>one</key>
			<string>Старше чем %@ день</string>
			<key>other</key>
			<string>Старше чем %@ дней</string>
