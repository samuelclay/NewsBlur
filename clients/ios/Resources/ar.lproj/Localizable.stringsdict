<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ opens</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@feed_opens@</string>
		<key>feed_opens</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>%@ مرة فتح</string>
			<key>many</key>
			<string>%@ مرة فتح</string>
			<key>one</key>
			<string>%@ مرة فتح</string>
			<key>other</key>
			<string>%@ مرة فتح</string>
			<key>two</key>
			<string>%@ مرتا فتح</string>
			<key>zero</key>
			<string>%@ مرة فتح</string>
		</dict>
	</dict>
	<key>%@ stories/month</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@average_stories_per_month@</string>
		<key>average_stories_per_month</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>%@ قصص/شهر</string>
			<key>many</key>
			<string>%@ قصة/شهر</string>
			<key>one</key>
			<string>%@ قصة/شهر</string>
			<key>other</key>
			<string>%@ قصة/شهر</string>
			<key>two</key>
			<string>%@ قصتان/شهر</string>
			<key>zero</key>
			<string>%@ قصة/شهر</string>
		</dict>
	</dict>
	<key>%@ subscribers</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@num_subscribers@</string>
		<key>num_subscribers</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>few</key>
			<string>%@ مشتركين</string>
			<key>many</key>
			<string>%@ مشتركًا</string>
			<key>one</key>
			<string>%@ مشترك</string>
			<key>other</key>
			<string>%@ مشتركًا</string>
			<key>two</key>
			<string>%@ مشتركان</string>
			<key>zero</key>
			<string>%@ مشترك</string>
		</dict>
	</dict>
</dict>
</plist>
