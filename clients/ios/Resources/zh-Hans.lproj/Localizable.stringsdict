<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ Widget Sites</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@site_count@</string>
		<key>site_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>%@ 个小组件网站</string>
		</dict>
	</dict>
	<key>%@ focused stories</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@focused_count@</string>
		<key>focused_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>%@ 篇重点报道</string>
		</dict>
	</dict>
	<key>%@ opens</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@feed_opens@</string>
		<key>feed_opens</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>打开 %@ 次</string>
		</dict>
	</dict>
	<key>%@ searches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@search_count@</string>
		<key>search_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>%@ 次搜索</string>
		</dict>
	</dict>
	<key>%@ stories</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@story_count@</string>
		<key>story_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>%@ 篇文章</string>
		</dict>
	</dict>
	<key>%@ stories left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@unread_count@</string>
		<key>unread_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>还剩 %@ 篇文章</string>
		</dict>
	</dict>
	<key>%@ stories/month</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@average_stories_per_month@</string>
		<key>average_stories_per_month</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>每月 %@ 篇文章</string>
		</dict>
	</dict>
	<key>%@ subscribers</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@num_subscribers@</string>
		<key>num_subscribers</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>%@ 位订阅者</string>
		</dict>
	</dict>
	<key>%@ unread stories</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@unread_count@</string>
		<key>unread_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>%@ 篇未读文章</string>
		</dict>
	</dict>
	<key>Followers label</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@follower_count@</string>
		<key>follower_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>关注者</string>
		</dict>
	</dict>
	<key>Imported %@ sites</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@imported_count@</string>
		<key>imported_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>已导入 %@ 个网站</string>
		</dict>
	</dict>
	<key>Mark these %@ stories read</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@visible_unread_count@</string>
		<key>visible_unread_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>将这 %@ 篇文章标记为已读</string>
		</dict>
	</dict>
	<key>Mute %@ Sites</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@site_count@</string>
		<key>site_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>屏蔽 %@ 个网站</string>
		</dict>
	</dict>
	<key>Older than %@ days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>超过 %@ 天</string>
		</dict>
	</dict>
	<key>Shared Stories label</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@shared_stories_count@</string>
		<key>shared_stories_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>分享的文章</string>
		</dict>
	</dict>
	<key>Storing past %@ days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>保存过去 %@ 天的内容</string>
		</dict>
	</dict>
	<key>Storing past %@ hours</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@hours@</string>
		<key>hours</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>保留过去 %@ 小时的内容</string>
		</dict>
	</dict>
	<key>You are subscribed to %@ sites</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@subscription_count@</string>
		<key>subscription_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>你已订阅%@个网站</string>
		</dict>
	</dict>
</dict>
</plist>
