	<key>You are subscribed to %@ sites</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@subscription_count@</string>
		<key>subscription_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>@</string>
			<key>other</key>
			<string>คุณสมัครรับข้อมูลจากเว็บไซต์ %@ แห่ง</string>
		</dict>
	</dict>
</dict>
</plist>
