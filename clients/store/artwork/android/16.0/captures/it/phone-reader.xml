wing-order="0" hint="" /><node index="3" text="Warm olive oil in a wide pan. Add cherry tomatoes and let them blister, turning occasionally, until their skins split and the juices begin to collect." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="4" text="Toss the pasta with the tomatoes, a few spoonfuls of pesto and a splash of cooking water. Keep tossing until the sauce lightly coats every strand." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="5" text="Finish with grated Parmesan, black pepper and fresh herbs. Put the pan in the middle of the table with crusty bread on the side." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="6" text="The little habit that makes this dinner easier: keep a jar of pesto in the fridge and good pasta in the cupboard. The rest can follow the season." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node></node>