true" focused="true" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[432,411][1080,1920]"><node index="0" text="A bright, generous bowl of pasta for the evenings when dinner needs to be simple. Sweet tomatoes, fresh pesto and a handful of Parmesan do all the work." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[450,429][1062,588]" /><node index="1" text="1803509623" resource-id="" class="android.widget.Image" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[432,607][1080,1581]" /><node index="2" text="Bring a large pot of salted water to a boil. Cook spaghetti until just tender, saving a mug of the starchy water before draining." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[450,1602][1062,1722]" /><node index="3" text="Warm olive oil in a wide pan. Add cherry tomatoes and let them blister, turning occasionally, until their skins split and the juices begin to collect." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[450,1741][1062,1902]" /><node index="4" text="Toss the pasta with the tomatoes, a few spoonfuls of pesto and a splash of cooking water. Keep tossing until the sauce lightly coats every strand." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="5" text="Finish with grated Parmesan, black pepper and fresh herbs. Put the pan in the middle of the table with crusty bread on the side." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="6" text="The little habit that makes this dinner easier: keep a jar of pesto in the fridge and good pasta in the cupboard. The rest can follow the season." resource-id="" class="android.widget.TextView" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /></node></node></node></node></node></node></node></node><node index="4" text="" resource-id="com.newsblur.storecapture:id/content_bottom_overlay" class="android.widget.FrameLayout" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[432,1813][1080,1902]"><node index="0" text="" resource-id="com.newsblur.storecapture:id/content_bottom_overlay_inner" class="android.view.ViewGroup" package="com.newsblur.storecapture" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" 