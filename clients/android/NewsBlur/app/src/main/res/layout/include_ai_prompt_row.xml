<?xml version="1.0" encoding="utf-8"?>
<!-- include_ai_prompt_row.xml: one AI prompt in the trainer, colored and wired by fragment/AiClassifierSections.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ai_prompt_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/ai_prompt_like"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/ic_thumb_up_yellow"
            android:contentDescription="@string/ai_prompt_focus" />

        <ImageButton
            android:id="@+id/ai_prompt_dislike"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/ic_thumb_down_yellow"
            android:contentDescription="@string/ai_prompt_hide" />

        <ImageButton
            android:id="@+id/ai_prompt_clear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/ic_clear"
            android:contentDescription="@string/ai_prompt_remove" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ai_prompt_scope_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/ai_prompt_scope_feed"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_scope_feed"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rss" />

        <ImageButton
            android:id="@+id/ai_prompt_scope_folder"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_scope_folder"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_folder" />

        <ImageButton
            android:id="@+id/ai_prompt_scope_global"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_scope_global"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_world" />

        <TextView
            android:id="@+id/ai_prompt_scope_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
