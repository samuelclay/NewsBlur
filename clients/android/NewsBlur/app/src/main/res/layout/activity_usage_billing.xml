<?xml version="1.0" encoding="utf-8"?>
<!-- activity_usage_billing.xml: natural language classifier billing, laid out like the billing and history
     sections of media/js/newsblur/reader/reader_account.js. activity/UsageBillingActivity.kt colors it per theme. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/toolbar_newsblur" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:id="@+id/billing_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/billing_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/usage_billing_title"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/billing_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/spend_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/spend_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/spend_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp" />

                        <FrameLayout
                            android:id="@+id/limit_bar"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:layout_marginTop="12dp"
                            android:visibility="gone">

                            <View
                                android:id="@+id/limit_bar_fill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/limit_bar_text"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/limit_reached_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/usage_billing_limit_reached_note"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/upcoming_charge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="13sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/billing_button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp" />

                    <LinearLayout
                        android:id="@+id/limit_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/limit_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/usage_billing_limit_label"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/limit_dollar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$"
                                android:textSize="16sp"
                                tools:ignore="HardcodedText" />

                            <EditText
                                android:id="@+id/limit_input"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:hint="@string/usage_billing_limit_hint"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="numberDecimal"
                                android:paddingHorizontal="10dp"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/limit_per_month"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/usage_billing_limit_per_month"
                                android:textSize="14sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/limit_save"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/usage_billing_limit_save"
                                android:letterSpacing="0"
                                android:textAllCaps="false"
                                app:cornerRadius="6dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/limit_help"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/usage_billing_limit_help"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/history_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/history_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/usage_billing_history_title"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/history_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/loading"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                    <LinearLayout
                        android:id="@+id/history_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
