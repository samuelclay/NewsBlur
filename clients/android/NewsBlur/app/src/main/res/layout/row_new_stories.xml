<?xml version="1.0" encoding="utf-8"?>
<!-- StoryViewAdapter.kt's "N new stories" row: stands in for NewStoriesPill.kt at the list's edge once the pill has
     stepped aside, sized like a compact story title and styled like the pill so it reads as a button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/new_stories_row_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textSize="15sp" />

</FrameLayout>
