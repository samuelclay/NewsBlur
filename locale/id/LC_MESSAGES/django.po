msgstr[0] "Sisa <strong class=\"NB-trial-days\">%(days)s hari</strong> dalam uji coba premium Anda"
msgstr[1] "Masa uji coba premium Anda tersisa <strong class=\"NB-trial-days\">%(days)s hari</strong>"

