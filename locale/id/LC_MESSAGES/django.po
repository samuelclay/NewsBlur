msgstr "Anda menyimpan \"<span class=\"NB-interaction-starred-story-title NB-splash-link\">%(title)s</span>\"."

#, python-format
msgid "You shared <span class=\"NB-interaction-sharedstory-title NB-splash-link\">%(title)s</span>."
msgstr "Anda membagikan <span class=\"NB-interaction-sharedstory-title NB-splash-link\">%(title)s</span>."

#, python-format
msgid "You shared <span class=\"NB-interaction-sharedstory-title NB-splash-link\">%(title)s</span>:"
msgstr "Anda membagikan <span class=\"NB-interaction-sharedstory-title NB-splash-link\">%(title)s</span>:"

