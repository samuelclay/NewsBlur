msgid ""
"You are at the front of the line! Just a few more minutes<br />until you receive your free invite to use "
"NewsBlur."
msgstr "אתם בראש התור! נותרו רק כמה דקות<br /> עד שתקבלו הזמנה בחינם להשתמש ב-NewsBlur."

#, python-format
msgid ""
"You are not required to use OAuth, in which case you will need to pass the <code>%(cookie_name)s</code> "
"cookie with every request. This cookie is set on <a href=\"#/api/login\">login</a>."
msgstr ""
"אין חובה להשתמש ב־OAuth; במקרה כזה יהיה עליכם לשלוח את קובץ ה־cookie מסוג <code>%(cookie_name)s</code> עם "
"כל בקשה. קובץ ה־cookie הזה מוגדר בעת <a href=\"#/api/login\">התחברות</a>."

msgid "You are not subscribed to this feed"
msgstr "אינך מנוי לעדכון הזה"

msgid "You can train per-feed, per-folder (Archive), or globally (Archive). Per-feed training is free."
msgstr "אפשר לאמן לפי פיד, לפי תיקייה (ארכיון) או באופן גלובלי (ארכיון). אימון לפי פיד הוא בחינם."

msgid "You cannot favorite your own shared story comment."
msgstr "אי אפשר להוסיף למועדפים תגובה משלך לכתבה ששותפה."

msgid "You cannot share newsletters. Somebody could unsubscribe you!"
msgstr "אי אפשר לשתף ניוזלטרים. מישהו עלול לבטל את ההרשמה שלך!"

msgid "You decide what to focus and hide"
msgstr "אתה מחליט במה להתמקד ומה להסתיר"

