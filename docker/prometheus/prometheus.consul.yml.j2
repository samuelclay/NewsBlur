global:
    scrape_interval: 30s
rule_files:
    - /etc/prometheus/rules.yml
scrape_configs:
    - job_name: 'node_exporter'
      # Node metrics are for big trends only (CPU, memory, disk, network, load), so
      # scrape at 60s and keep just those families. The full exporter emits ~900
      # series per host across ~56 hosts; the keep list below plus the slower
      # cadence cuts node ingest ~13x. Short-zoom rate() panels on the stock
      # node-exporter dashboard get patchier; multi-day trends are unaffected.
      scrape_interval: 60s
      consul_sd_configs:
      - server: 'consul.service.nyc1.consul:8500'
        services: ['node-exporter']
      relabel_configs:
      - source_labels: ['__meta_consul_node']
        target_label: instance
      metric_relabel_configs:
      - source_labels: ['__name__']
        regex: node_cpu_seconds_total|node_memory_(MemTotal|MemAvailable|MemFree|Buffers|Cached|SwapTotal|SwapFree|Committed_AS)_bytes|node_filesystem_(size|avail|free)_bytes|node_filesystem_readonly|node_disk_(read_bytes|written_bytes|io_time_seconds)_total|node_disk_(reads|writes)_completed_total|node_network_(receive|transmit)_(bytes|errs)_total|node_load1|node_load5|node_load15|node_boot_time_seconds|node_time_seconds|node_uname_info
        action: keep


    - job_name: 'mongo_exporter'
      consul_sd_configs:
      - server: 'consul.service.nyc1.consul:8500'
        services: ['mongo-exporter']
      relabel_configs:
      - source_labels: ['__meta_consul_node']
        target_label: instance


    - job_name: 'postgres_exporter'
      consul_sd_configs:
      - server: 'consul.service.nyc1.consul:8500'
        services: ['postgres-exporter']
      relabel_configs:
      - source_labels: ['__meta_consul_node']
        target_label: instance


    ## config for the multiple Redis targets that the exporter will scrape
    - job_name: 'redis_exporter'
      consul_sd_configs:
      - server: 'consul.service.nyc1.consul:8500'
        services: ['redis-exporter']
      relabel_configs:
      - source_labels: ['__meta_consul_service_id']
        target_label: instance

    - job_name: 'prometheus'
      static_configs:
        - targets: ['localhost:9090']
    - job_name: 'app_servers'
      static_configs:
        - targets: ['{{ monitor_server }}']
      metrics_path: /monitor/app-servers
