    - job_name: 'django'
{% if disable_consul_services_ie_staging is defined %}
      static_configs:
        - targets: ['{{ monitor_server }}']
      scheme: https
      relabel_configs:
        - target_label: instance
          replacement: '{{ monitor_server }}:443'
{% else %}
      consul_sd_configs:
        - server: 'consul.service.nyc1.consul:8500'
          services: ['app-web']
      relabel_configs:
        - source_labels: ['__meta_consul_node']
          target_label: instance
{% endif %}
      metrics_path: /metrics
      # The per-view latency histogram is the single biggest series family in the
      # TSDB (~40% of all series: view x method x le x app server). Only two views
      # are ever charted with quantiles (newsblur_dashboard.json panels 97 and 106),
      # so keep _bucket series for those views alone. _sum and _count survive for
      # every view, which is all the average-latency panels need. RE2 has no
      # negative lookahead, hence the mark-then-drop dance with a temp label.
      metric_relabel_configs:
        - source_labels: ['__name__']
          regex: django_http_requests_latency_seconds_by_view_method_bucket
          target_label: __tmp_view_bucket
          replacement: bucket
        - source_labels: ['__tmp_view_bucket', 'view']
          regex: bucket;(load-single-feed|load-river-stories)
          target_label: __tmp_view_bucket
          replacement: charted
        - source_labels: ['__tmp_view_bucket']
          regex: bucket
          action: drop
        - regex: __tmp_view_bucket
          action: labeldrop

